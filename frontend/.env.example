# Copy to .env.local and fill in. Never commit .env.local.

# Required. Server-only: used by the /api routes and never sent to the browser.
# Do not create a NEXT_PUBLIC_ copy of it. Free key: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# Optional. Absolute site URL for social-preview links (og:image).
# On Vercel this defaults to the production domain; locally to http://localhost:3000.
# SITE_URL=https://your-domain.example
